#!/usr/bin/env bash

PROFILE="$1"
RICE="$HOME/github/rice-profiles"

# Wallpaper backend
if [ "$PROFILE" = "set" ]; then
    case "$2" in
        swww)
            echo "swww" > "$RICE/wallpaper-backend"
            pkill -x hyprpaper 2>/dev/null
            if ! pgrep -x swww-daemon >/dev/null; then
                swww-daemon >/dev/null 2>&1 &
                sleep 1
            fi
            echo "Wallpaper backend: swww"
            exit 0
            ;;

        hyprpaper)
            echo "hyprpaper" > "$RICE/wallpaper-backend"
            pkill -x swww-daemon 2>/dev/null
            if ! pgrep -x hyprpaper >/dev/null; then
                hyprpaper >/dev/null 2>&1 &
                sleep 1
            fi
            echo "Wallpaper backend: hyprpaper"
            exit 0
            ;;

        *)
            echo "Usage: profile set {swww|hyprpaper}"
            exit 1
            ;;
    esac
fi

if [ ! -d "$RICE/$PROFILE" ]; then
    echo "Profile '$PROFILE' does not exist"
    echo "Available profiles:"
    ls "$RICE" | grep -v scripts | grep -v wallpapers
    exit 1
fi


# Waybar
ln -sfn "$RICE/$PROFILE/waybar/config.jsonc" \
    "$HOME/.config/waybar/config.jsonc"

ln -sfn "$RICE/$PROFILE/waybar/style.css" \
    "$HOME/.config/waybar/style.css"


# Wofi
ln -sfn "$RICE/$PROFILE/wofi/style.css" \
    "$HOME/.config/wofi/style.css"


# Fastfetch
ln -sfn "$RICE/$PROFILE/fastfetch/config.jsonc" \
    "$HOME/.config/fastfetch/config.jsonc"


# Kitty
ln -sfn "$RICE/$PROFILE/kitty/theme.conf" \
    "$HOME/.config/kitty/current-theme.conf"

kitty @ load-config "$HOME/.config/kitty/current-theme.conf" >/dev/null 2>&1

# Starship
ln -sfn "$RICE/$PROFILE/starship/starship.toml" \
    "$HOME/.config/starship.toml"


# Wallpaper
WALLPAPER="$RICE/wallpapers/$PROFILE.jpg"
BACKEND=$(cat "$RICE/wallpaper-backend" 2>/dev/null || echo hyprpaper)

if [ -f "$WALLPAPER" ]; then
    if [ "$BACKEND" = "swww" ]; then
        if ! pgrep -x swww-daemon >/dev/null; then
            swww-daemon >/dev/null 2>&1 &
            sleep 1
        fi

        swww img "$WALLPAPER"
    else
        if pgrep -x hyprpaper >/dev/null; then
            hyprctl monitors -j | jq -r '.[].name' | while read -r MONITOR; do
                hyprctl hyprpaper wallpaper "$MONITOR,$WALLPAPER,cover"
            done
        fi
    fi
fi

sleep 1

BACKEND=$(cat "$RICE/wallpaper-backend" 2>/dev/null || echo hyprpaper)

if [ "$BACKEND" = "swww" ]; then
    if ! pgrep -x swww-daemon >/dev/null; then
        swww-daemon >/dev/null 2>&1 &
        sleep 1
    fi

    swww img "$WALLPAPER" >/dev/null 2>&1
else
    hyprctl monitors -j | jq -r '.[].name' | while read -r MONITOR; do
        hyprctl hyprpaper wallpaper "$MONITOR,$WALLPAPER,cover"
    done
fi


# Restart Waybar
pkill waybar
waybar >/dev/null 2>&1 &

# Refresh terminal
clear

# Show system info
fastfetch

echo "Loaded profile: $PROFILE"
