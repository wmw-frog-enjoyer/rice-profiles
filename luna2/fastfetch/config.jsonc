{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "kitty",
        "source": "~/github/rice-profiles/luna2/fastfetch/image.jpg",
        "width": 30,
        "preserveAspectRatio": true,
        "padding": {
            "top": 2,
            "left": 2,
            "right": 6
        }
    },

    "display": {
        "separator": " -> ",
        "color": {
            "keys": "38;2;163;15;26"
        }
    },

    "modules": [
        {
            "type": "custom",
            "format": "\n\n"
        },

        {
            "type": "title",
            "format": "frog enjoys freedom from systemd",
            "color": {
                "user": "38;2;163;15;26",
                "at": "white",
                "host": "38;2;163;15;26"
            }
        },

        {
            "type": "custom",
            "format": "────────────────────"
        },

        "os",
        "kernel",
        "uptime",
        "wm",
        "terminal",
        "cpu",
        "gpu",
        "memory"
    ]
}
